---
const address = "حي, Basrah, Basra Governorate, 61001";
const phone = "+964 776 925 5592";
---

<section id="contact" class="py-24 bg-brand-dark text-brand-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <span class="text-brand-warm font-medium tracking-widest uppercase text-sm">Contact & Location</span>
        <h2 class="text-4xl md:text-5xl font-display font-bold mt-2 mb-6">Find Us in Basra</h2>
        <div class="space-y-4 text-brand-cream/80">
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-1 text-brand-warm"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{address}</span>
          </div>
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand-warm"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={`tel:${phone}`} class="hover:underline">{phone}</a>
          </div>
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand-warm"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span class="flex items-center gap-2"><span class="h-3 w-3 bg-green-400 rounded-full inline-block"></span> Open now · 7:30AM – 12:00AM</span>
          </div>
        </div>
        <div class="mt-8 flex gap-4">
          <a href="https://www.google.com/maps/search/?q=CHAI+cafe+and+bakehouse+Basra" target="_blank" class="inline-flex items-center gap-2 bg-brand-warm text-brand-dark px-6 py-3 rounded-full font-semibold hover:bg-brand-warm/80 transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 11 7 11s7-5.75 7-11c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            Open in Maps
          </a>
          <a href={`tel:${phone}`} class="inline-flex items-center gap-2 border border-brand-warm/50 text-brand-warm px-6 py-3 rounded-full font-semibold hover:bg-brand-warm/10 transition">
            Call Now
          </a>
        </div>
      </div>
      <div class="reveal reveal-delay-2 rounded-2xl overflow-hidden shadow-2xl border-4 border-brand-warm/20">
        <!-- Static map placeholder; in production, embed Google Maps iframe -->
        <div class="w-full aspect-video bg-brand-dark-cream flex items-center justify-center">
          <img src="https://lh3.googleusercontent.com/gps-cs-s/AHRPTWm2ThFBYy-Or93Z7QvAfIYOrbkABr4wOzdwMJKmeAam-2jItkJCZpvp74ED3vmptZstiTxOV_T2dysp4-Uv8Bhvh2IYSz-ObZ8bfheRX2H2Qb_4nntC7Caj_VkDaAyoJX6LaNIwvR2W7kk=w408-h544-k-no" alt="CHAI cafe exterior" class="w-full h-full object-cover" />
        </div>
        <div class="p-4 bg-brand-dark/90 text-center">
          <p class="text-sm text-brand-cream/70">📍 {address}</p>
        </div>
      </div>
    </div>
  </div>
</section>