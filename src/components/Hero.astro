---
const logo = "CHAI";
const title = "Let chai connect us";
const subtitle = "Cozy cafe & bakehouse in Basra – handcrafted drinks, baked goods, and warm memories.";
---

<section id="home" class="relative overflow-hidden min-h-screen flex items-center justify-center bg-brand-cream bg-hero-pattern">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent to-brand-cream/30 pointer-events-none"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid md:grid-cols-2 gap-12 items-center">
    <div class="reveal space-y-6">
      <span class="inline-block px-4 py-1.5 bg-brand-warm/10 text-brand-accent rounded-full text-sm font-medium tracking-wide uppercase">
        ⭐ 4.5 on Google · 4 reviews
      </span>
      <h1 class="text-5xl sm:text-6xl lg:text-8xl font-display font-bold leading-tight text-brand-dark">
        {title}
      </h1>
      <p class="text-lg text-brand-dark/70 max-w-md">
        {subtitle}
      </p>
      <div class="flex flex-wrap gap-4 pt-4">
        <a href="tel:+9647769255592" class="group relative inline-flex items-center gap-2 bg-brand-warm text-white px-8 py-4 rounded-full text-lg font-semibold shadow-lg hover:bg-brand-accent hover:shadow-xl transition-all duration-300">
          <span>Order Delivery</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#menu" class="inline-flex items-center gap-2 border-2 border-brand-dark/20 text-brand-dark px-8 py-4 rounded-full text-lg font-medium hover:border-brand-warm hover:text-brand-warm transition-all">
          Explore Menu
        </a>
      </div>
      <div class="flex items-center gap-4 mt-8 text-sm text-brand-dark/60">
        <span class="flex items-center gap-1">🕑 Open now</span>
        <span>|</span>
        <span>7:30AM – 12:00AM daily</span>
      </div>
    </div>
    <div class="relative reveal reveal-delay-2 hidden md:block">
      <div class="relative mx-auto w-80 h-96 rounded-3xl overflow-hidden shadow-2xl border-4 border-white/80 transform rotate-2 hover:rotate-0 transition-transform duration-700">
        <img src="https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/818714040_17909885334493821_4834725978523488867_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=109&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=7vFtLNaXugcQ7kNvwEpX4AF&_nc_oc=AdqPUQWlP2NFKI95mkiZC29jlMzKWKxT5sUv1GYl_jfbHx5ts1q5VLVYxvl0CN0NGKo&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=TPlPnQvIUkHT_E9IYpo8eQ&_nc_ss=72a8c&oh=00_AQKZS5Rg8iQG_KMG3Z8AyAGww93b1WRcmvc58k72_DvDPg&oe=6ABCE0C2" alt="Barista crafting coffee at CHAI" class="w-full h-full object-cover" loading="eager" />
      </div>
      <div class="absolute -bottom-6 -left-6 w-28 h-28 bg-brand-warm rounded-full flex items-center justify-center text-white text-sm font-bold shadow-lg reveal reveal-delay-4">
        10.7k <br/>followers
      </div>
      <div class="absolute -top-8 -right-8 w-24 h-24 bg-white rounded-full flex items-center justify-center shadow-xl reveal reveal-delay-3">
        <img src="https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/656068162_17882213007493821_332529252036747882_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=103&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=ajUVG5sxhP0Q7kNvwHSJcwY&_nc_oc=Adq_948Apkfc_nNN1Z_qCj08kTXUU7e0QyOdNWnuHuh0Rk9reqF2H9ZPOpAPGFENOys&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=txyfKSeMRZM91dzeuwgerQ&_nc_ss=72a8c&oh=00_AQJSmySRO6ymAZnVH5nCoKSTuf0P2Y4Kxk78QRAit2_mjg&oe=6ABCCF21" alt="CHAI profile" class="w-20 h-20 rounded-full object-cover border-4 border-white" />
      </div>
    </div>
  </div>
</section>