<section id="gallery" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12 reveal">
      <div>
        <span class="text-brand-accent font-medium tracking-widest uppercase text-sm">Instagram Feed</span>
        <h2 class="text-4xl md:text-5xl font-display font-bold mt-2">From Our Community</h2>
        <p class="mt-2 text-brand-dark/70">Follow us <a href="https://www.instagram.com/chai.basra/" target="_blank" class="underline font-semibold">@chai.basra</a> · 10.7k followers</p>
      </div>
      <a href="https://www.instagram.com/chai.basra/" target="_blank" class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-medium text-brand-dark/70 hover:text-brand-accent transition">
        View all posts
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
      {igPosts.map((post, i) => (
        <div class={`reveal reveal-delay-${( i % 4) + 1} group relative rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-500 hover:-translate-y-1 bg-white`}>
          <div class="aspect-square overflow-hidden">
            <img src={post.image} alt={post.caption.slice(0, 50)} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4">
            <p class="text-white text-xs line-clamp-3 leading-relaxed">{post.caption}</p>
            <div class="flex items-center gap-2 mt-2 text-white/80 text-xs">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              <span>{post.likes || '0'} likes</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>